# Supabase — ambil dari Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Di dashboard namanya "Publishable key" (project baru) atau "anon public"
# (project lama). Keduanya berlaku, isikan di variabel yang sama ini.
# JANGAN memakai Secret key / service_role di sini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# URL publik aplikasi (dipakai untuk redirect email confirmation)
# Lokal: http://localhost:3000 — Vercel: https://<project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPSIONAL — "Secret key" (sb_secret_...) atau "service_role" pada project lama.
# Hanya untuk fitur hapus akun peserta di panel mentor.
# Key ini MELEWATI seluruh Row Level Security: simpan hanya di server,
# jangan beri awalan NEXT_PUBLIC_, dan jangan pernah di-commit.
# Tanpa ini aplikasi tetap jalan; hanya tombol hapus akun yang nonaktif.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
