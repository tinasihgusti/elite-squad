# Supabase — ambil dari Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL publik aplikasi (dipakai untuk redirect email confirmation)
# Lokal: http://localhost:3000 — Vercel: https://<project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPSIONAL — service_role key, hanya untuk fitur hapus akun peserta di panel mentor.
# Key ini MELEWATI seluruh Row Level Security: simpan hanya di server,
# jangan beri awalan NEXT_PUBLIC_, dan jangan pernah di-commit.
# Tanpa ini aplikasi tetap jalan; hanya tombol hapus akun yang nonaktif.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
